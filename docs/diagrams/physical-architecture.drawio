<mxfile host="drawio" version="26.0.0"><diagram name="Physical architecture"><mxGraphModel dx="1700" dy="1060" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Live Games: physical architecture&lt;/b&gt; (Fly.io app &lt;i&gt;livebingo&lt;/i&gt;, https://livebingo.fly.dev)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="players" value="&lt;b&gt;Players&lt;/b&gt;&lt;br&gt;browser / phone&lt;br&gt;pages poll with HTMX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="200" height="80" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;Host / admin&lt;/b&gt;&lt;br&gt;browser, /admin&lt;br&gt;(HTTP Basic)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="200" height="60" as="geometry"/></mxCell><mxCell id="operator" value="&lt;b&gt;Operator laptop&lt;/b&gt;&lt;br&gt;fly CLI, scripts/fly-*.sh&lt;br&gt;data/backup/*.sql" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="200" height="90" as="geometry"/></mxCell><mxCell id="proxy" value="&lt;b&gt;Fly.io edge proxy&lt;/b&gt;&lt;br&gt;TLS (HTTPS)&lt;br&gt;adds Fly-Client-IP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="180" height="150" as="geometry"/></mxCell><mxCell id="region" value="Fly.io region gru (São Paulo)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;container=1;pointerEvents=0;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#f7f2fa;" vertex="1" p