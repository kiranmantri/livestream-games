POSTGRES_USER=livegames
POSTGRES_PASSWORD=change-me
POSTGRES_DB=livegames
# Host-side URL (dev). Inside compose the host will be "db".
DATABASE_URL=postgresql://livegames:change-me@127.0.0.1:5432/livegames
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-long-random

# Max players allowed from one source IP in a session (shared Wi-Fi vs fake users)
MAX_USERS_PER_IP=3
# Comma-separated IPs of reverse proxies whose X-Forwarded-For is trusted (empty = trust none)
TRUSTED_PROXIES=

# Timezone for times shown in the UI (IANA name)
TIMEZONE=America/Sao_Paulo

# --- docker compose deployment (docker compose up -d --build)
# POSTGRES_PASSWORD must be URL-safe (it is embedded in the app's DATABASE_URL); ADMIN_PASSWORD must not be "change-me".
# Host interface/port the app is published on. Keep 127.0.0.1 behind a TLS reverse proxy; 0.0.0.0 exposes plain HTTP.
APP_BIND=127.0.0.1
APP_PORT=8000
# 1 when the site is served over HTTPS (marks the player cookie Secure)
COOKIE_SECURE=0

# --- Speech to text for the live Falacias game. Empty STT_PROVIDER = off (players use the typed phrase box).
# STT_PROVIDER: groq (default in the cloud, ~US$0.04/h) | grok (xAI) | whispercpp (needs STT_URL; local only)
STT_PROVIDER=
# pt (default) | en | any 2-3 letter code | auto
STT_LANGUAGE=pt

# --- API keys. Leave empty what you do not use. NEVER commit .env (it is in .gitignore and .dockerignore).
# Create keys at console.groq.com/keys, console.x.ai and openrouter.ai/keys.
GROQ_API_KEY=
XAI_API_KEY=
# OpenRouter is used by the fact-checker spike only (spikes/checker.py: --models openrouter:<model id>); the app does not read it yet.
OPENROUTER_API_KEY=

# Optional (rarely needed): OLLAMA_BASE_URL, GROQ_BASE_URL, OPENROUTER_BASE_URL, STT_API_URL, LIVE_VIDEO_ID, LIVE_CHANNEL_URL, REPLAY_COLLECTOR=off
